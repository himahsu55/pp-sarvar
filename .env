# ==============================================================================
# Staff Punch Backend - Environment Configuration
# ==============================================================================
# For Local Development:
#   Copy this file to ".env" and fill in your values.
#   Never commit the real ".env" file to GitHub!
#
# For Vercel Deployment:
#   Add these key-value pairs in:
#   Vercel Dashboard -> Your Project -> Settings -> Environment Variables
# ==============================================================================

PORT=5331

# JWT Secret Key (Required in production)
# Generate a secure string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY
JWT_DAYS=7

# Default Admin Account credentials (used to bootstrap the admin account)
ADMIN_ID=admin
ADMIN_PASSWORD=himesh@7

# Forgot the admin password? Set ADMIN_RESET=true, restart ONCE, log in, then delete this line.
# ADMIN_RESET=true

# Office Location Coordinates (GPS)
# Open Google Maps -> Right-click your office location -> Copy Latitude & Longitude
OFFICE_LAT=21.754128
OFFICE_LNG=72.991026
OFFICE_RADIUS_METERS=150
MAX_GPS_ACCURACY_METERS=50

# Timezone offset in minutes from UTC (India IST = 330)
TZ_OFFSET_MINUTES=330

# App lock settings
LOCK_GRACE_MINUTES=60
# REQUIRE_APP_LOCK=false

# Optional / Deployment settings
# NODE_ENV=production
# CORS_ORIGIN=*
# TRUST_PROXY=true
# BACKUP_KEEP=14
